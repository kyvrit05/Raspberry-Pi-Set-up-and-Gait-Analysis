"""
Subject-level normal vs abnormal classifier.

Instead of classifying individual strides/windows (where label noise is high -
a person with mild disease still produces many normal-looking strides), this
aggregates each subject's ENTIRE recording into one row of variability
features, then classifies per-subject.

Uses Leave-One-Subject-Out cross-validation (not a single train/test split)
because with only 64 subjects, one holdout split is too small/noisy to trust.
"""

import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestClassifier
from sklearn.model_selection import LeaveOneGroupOut
from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score
from sklearn.preprocessing import LabelEncoder

RAW_FEATURES = [
    "left_stride_interval_s",
    "right_stride_interval_s",
    "left_swing_interval_s",
    "right_swing_interval_s",
    "left_swing_pct",
    "right_swing_pct",
    "left_stance_interval_s",
    "right_stance_interval_s",
    "left_stance_pct",
    "right_stance_pct",
    "double_support_interval_s",
    "double_support_pct",
]

def build_subject_features(df: pd.DataFrame) -> pd.DataFrame:
    """One row per subject: mean, std, and coefficient of variation (CV) for
    every raw feature, plus a couple of left-right asymmetry measures."""
    rows = []
    for subject_id, g in df.groupby("subject_id"):
        row = {"subject_id": subject_id, "label": g["label"].iloc[0]}

        for col in RAW_FEATURES:
            mean = g[col].mean()
            std = g[col].std()
            cv = std / mean if mean != 0 else 0.0
            row[f"{col}_mean"] = mean
            row[f"{col}_std"] = std
            row[f"{col}_cv"] = cv

        # left-right asymmetry: how differently the two sides behave
        row["stride_asymmetry"] = (
            (g["left_stride_interval_s"] - g["right_stride_interval_s"]).abs().mean()
        )
        row["stance_asymmetry"] = (
            (g["left_stance_pct"] - g["right_stance_pct"]).abs().mean()
        )

        rows.append(row)

    return pd.DataFrame(rows)

def main():
    strides = pd.read_csv("gaitndd_strides.csv").dropna(subset=RAW_FEATURES)
    subjects = build_subject_features(strides)

    feature_cols = [c for c in subjects.columns if c not in ("subject_id", "label")]
    X = subjects[feature_cols].values
    y = LabelEncoder().fit_transform(subjects["label"])  # check classes_ below
    groups = subjects["subject_id"].values

    print(f"{len(subjects)} subjects, {len(feature_cols)} features")
    print(subjects["label"].value_counts())

    logo = LeaveOneGroupOut()
    all_true, all_pred, all_proba = [], [], []

    for train_idx, test_idx in logo.split(X, y, groups):
        clf = RandomForestClassifier(
            n_estimators=300,
            max_depth=6,
            class_weight="balanced",
            random_state=42,
            n_jobs=-1,
        )
        clf.fit(X[train_idx], y[train_idx])
        pred = clf.predict(X[test_idx])
        proba = clf.predict_proba(X[test_idx])[:, 1]

        all_true.extend(y[test_idx])
        all_pred.extend(pred)
        all_proba.extend(proba)

    print("\n=== Leave-One-Subject-Out Results (default 0.5 threshold) ===")
    print(classification_report(all_true, all_pred, target_names=["normal", "abnormal"]))
    print("Confusion matrix:")
    print(confusion_matrix(all_true, all_pred))
    print(f"ROC-AUC: {roc_auc_score(all_true, all_proba):.3f}")

    # --- Threshold tuning ---
    # Default 0.5 cutoff treats false positives and false negatives as equally
    # costly. For a clinical screening tool, missing an abnormal case is
    # usually worse than a false alarm, so we sweep lower thresholds and see
    # how recall/precision trade off.
    all_true_arr = np.array(all_true)
    all_proba_arr = np.array(all_proba)

    print("\n=== Threshold Sweep (abnormal = positive class) ===")
    print(f"{'threshold':>10} {'precision':>10} {'recall':>10} {'f1':>8}")
    for thresh in [0.5, 0.4, 0.35, 0.3, 0.25, 0.2, 0.15]:
        preds_at_thresh = (all_proba_arr >= thresh).astype(int)
        tp = np.sum((preds_at_thresh == 1) & (all_true_arr == 1))
        fp = np.sum((preds_at_thresh == 1) & (all_true_arr == 0))
        fn = np.sum((preds_at_thresh == 0) & (all_true_arr == 1))
        precision = tp / (tp + fp) if (tp + fp) > 0 else 0.0
        recall = tp / (tp + fn) if (tp + fn) > 0 else 0.0
        f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0.0
        print(f"{thresh:>10.2f} {precision:>10.2f} {recall:>10.2f} {f1:>8.2f}")

    # Pick a threshold here after reviewing the sweep above, then show the
    # detailed report at that chosen threshold.
    CHOSEN_THRESHOLD = 0.35  # adjust based on the sweep results you see
    tuned_preds = (all_proba_arr >= CHOSEN_THRESHOLD).astype(int)

    print(f"\n=== Results at chosen threshold ({CHOSEN_THRESHOLD}) ===")
    print(classification_report(all_true_arr, tuned_preds, target_names=["normal", "abnormal"]))
    print("Confusion matrix:")
    print(confusion_matrix(all_true_arr, tuned_preds))

    # train once more on everything to inspect which features matter most
    clf_full = RandomForestClassifier(
        n_estimators=300, max_depth=6, class_weight="balanced", random_state=42, n_jobs=-1
    )
    clf_full.fit(X, y)
    importances = pd.Series(clf_full.feature_importances_, index=feature_cols).sort_values(ascending=False)
    print("\n=== Top 10 Feature Importances ===")
    print(importances.head(10))

if __name__ == "__main__":
    main()