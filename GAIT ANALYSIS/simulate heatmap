"""
Simulates footstep pressure grid data and renders it as a heatmap, so you can
test/verify the Raspberry Pi display pipeline BEFORE the real mat hardware is
wired up. Swap simulate_footstep() for real serial-read data later - the
rendering function stays the same either way.
"""

import numpy as np
import matplotlib.pyplot as plt
import time

GRID_ROWS, GRID_COLS = 12, 10  # matches your Velostat mat's sensor grid

def simulate_footstep(step_number: int, total_steps: int = 4) -> tuple:
    """
    Simulates ONE footstep per call, with its position progressing along the
    mat's row axis (forward direction) as step_number increases - so across
    `total_steps` calls, it looks like a person walking across the mat,
    alternating left/right foot each step.

    Returns (grid, foot_label).
    """
    grid = np.zeros((GRID_ROWS, GRID_COLS))

    # row position advances from one end of the mat to the other across the steps
    # (reversed: starts at the high-row end and moves toward row 0)
    if total_steps > 1:
        row_center = round((GRID_ROWS - 1) - (step_number / (total_steps - 1) * (GRID_ROWS - 1)))
    else:
        row_center = GRID_ROWS // 2

    # alternate left/right foot, offset slightly either side of the centerline
    foot = "left" if step_number % 2 == 0 else "right"
    col_center = (GRID_COLS // 2 - 2) if foot == "left" else (GRID_COLS // 2 + 2)

    heel_row = row_center + 1
    forefoot_row = row_center - 1
    for r in range(GRID_ROWS):
        for c in range(GRID_COLS):
            dist_heel = np.hypot(r - heel_row, c - col_center)
            dist_fore = np.hypot(r - forefoot_row, c - col_center)
            pressure = 80 * np.exp(-dist_heel**2 / 3) + 60 * np.exp(-dist_fore**2 / 3)
            grid[r, c] = pressure

    grid += np.random.normal(0, 5, size=grid.shape)  # sensor noise
    grid = np.clip(grid, 0, 100)
    return grid, foot

def run_live_display(num_steps: int = 30, delay: float = 0.6):
    """
    Single window that updates in place - this is the pattern you'll want for
    the real ESP32 feed too: one persistent window, redrawn each time a new
    reading comes in, instead of opening a new window per frame.

    Uses nearest-neighbor interpolation (no blurring) plus grid lines so each
    of the 12x10 individual sensor cells is clearly visible as a distinct
    square, rather than a smoothed/blended heatmap.
    """
    plt.ion()  # interactive mode - lets the window update without blocking
    fig, ax = plt.subplots(figsize=(6, 7))
    im = ax.imshow(np.zeros((GRID_ROWS, GRID_COLS)), cmap="jet",
                    interpolation="nearest", vmin=0, vmax=100)
    plt.colorbar(im, ax=ax, label="Pressure (simulated units)")
    title = ax.set_title("")

    # grid lines match the standard (ROWS x COLS) display shape:
    # rows = y-axis, columns = x-axis
    ax.set_xticks(np.arange(-0.5, GRID_COLS, 1), minor=True)
    ax.set_yticks(np.arange(-0.5, GRID_ROWS, 1), minor=True)
    ax.grid(which="minor", color="white", linestyle="-", linewidth=1.2)
    ax.set_xticks(np.arange(0, GRID_COLS, 1))
    ax.set_yticks(np.arange(0, GRID_ROWS, 1))
    ax.tick_params(which="major", length=0)  # hide major tick marks, keep labels

    for step in range(num_steps):
        grid, foot = simulate_footstep(step, total_steps=num_steps)

        im.set_data(grid)          # standard orientation: rows=y, columns=x
        title.set_text(f"Step {step + 1} of {num_steps} ({foot} foot)")
        fig.canvas.draw()
        fig.canvas.flush_events()

        time.sleep(delay)  # replace with however fast ESP32 sends readings

    plt.ioff()
    plt.show()  # keep the final frame open at the end

if __name__ == "__main__":
    run_live_display(num_steps=4, delay=1.0)