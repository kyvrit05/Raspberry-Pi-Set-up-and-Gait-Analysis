"""
Trains a baseline Random Forest classifier on the gaitndd stride dataset
(gaitndd_strides.csv produced by load_gaitndd.py).

Splits by SUBJECT, not by row, so strides from the same person never end up
in both train and test - otherwise accuracy would be artificially inflated
since strides from one subject look very similar to each other.
"""

import pandas as pd
from sklearn.model_selection import GroupShuffleSplit
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score
from sklearn.preprocessing import LabelEncoder

FEATURE_COLUMNS = [
    "left_stride_interval_s",
    "right_stride_interval_s",
    "left_swing_interval_s",
    "right_swing_interval_s",
    "left_swing_pct",
    "right_swing_pct",
    "left_stance_interval_s",
    "right_stance_interval_s",
    "left_stance_pct",
    "right_stance_pct",
    "double_support_interval_s",
    "double_support_pct",
]

def main():
    df = pd.read_csv("gaitndd_strides.csv")

    # drop rows with missing/garbage values (some strides at start/end of a
    # recording can have NaNs from the derivation process)
    df = df.dropna(subset=FEATURE_COLUMNS)

    X = df[FEATURE_COLUMNS]
    y = LabelEncoder().fit_transform(df["label"])  # normal=0/abnormal=1 (order may vary - check below)
    groups = df["subject_id"]

    print("Label encoding check:", dict(zip(df["label"].unique(), y[:1] if False else "see classes_")))

    # subject-level split: 80% of SUBJECTS in train, 20% in test
    splitter = GroupShuffleSplit(test_size=0.2, n_splits=1, random_state=42)
    train_idx, test_idx = next(splitter.split(X, y, groups))

    X_train, X_test = X.iloc[train_idx], X.iloc[test_idx]
    y_train, y_test = y[train_idx], y[test_idx]

    print(f"Train: {len(X_train)} strides from {groups.iloc[train_idx].nunique()} subjects")
    print(f"Test:  {len(X_test)} strides from {groups.iloc[test_idx].nunique()} subjects")

    clf = RandomForestClassifier(
        n_estimators=300,
        max_depth=8,
        class_weight="balanced",  # handles the ~3:1 abnormal:normal imbalance
        random_state=42,
        n_jobs=-1,
    )
    clf.fit(X_train, y_train)

    y_pred = clf.predict(X_test)
    y_proba = clf.predict_proba(X_test)[:, 1]

    print("\n=== Classification Report ===")
    print(classification_report(y_test, y_pred, target_names=["normal", "abnormal"]))

    print("=== Confusion Matrix ===")
    print(confusion_matrix(y_test, y_pred))

    print(f"\nROC-AUC: {roc_auc_score(y_test, y_proba):.3f}")

    print("\n=== Feature Importances ===")
    importances = pd.Series(clf.feature_importances_, index=FEATURE_COLUMNS).sort_values(ascending=False)
    print(importances)

if __name__ == "__main__":
    main()