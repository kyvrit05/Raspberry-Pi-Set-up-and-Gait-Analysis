"""
Loads the Gait in Neurodegenerative Disease Database (.ts files) into a
single labeled dataframe: one row per stride, columns = the 13 .ts fields,
plus subject id, disease group, and binary normal/abnormal label.

Expects a folder containing all the .ts files + subject-description.txt
(the raw unzipped PhysioNet folder).
"""

import pandas as pd
from pathlib import Path

TS_COLUMNS = [
    "elapsed_time_s",
    "left_stride_interval_s",
    "right_stride_interval_s",
    "left_swing_interval_s",
    "right_swing_interval_s",
    "left_swing_pct",
    "right_swing_pct",
    "left_stance_interval_s",
    "right_stance_interval_s",
    "left_stance_pct",
    "right_stance_pct",
    "double_support_interval_s",
    "double_support_pct",
]

def load_subject_description(data_dir: Path) -> pd.DataFrame:
    # tab-delimited, first column is subject id (e.g. "als1"); adjust if your
    # copy has a header row - inspect it first with a text editor if this fails
    desc = pd.read_csv(data_dir / "subject-description.txt", sep="\t")
    return desc

def group_from_filename(stem: str) -> str:
    for prefix in ("als", "hunt", "park", "control"):
        if stem.startswith(prefix):
            return prefix
    return "unknown"

def load_all_ts(data_dir: Path) -> pd.DataFrame:
    rows = []
    for ts_file in sorted(data_dir.glob("*.ts")):
        subject_id = ts_file.stem
        group = group_from_filename(subject_id)
        label = "normal" if group == "control" else "abnormal"

        df = pd.read_csv(ts_file, sep=r"\s+", header=None, names=TS_COLUMNS)
        df["subject_id"] = subject_id
        df["group"] = group
        df["label"] = label
        rows.append(df)

    return pd.concat(rows, ignore_index=True)

if __name__ == "__main__":
    # change this to wherever you unzipped the PhysioNet folder
    DATA_DIR = Path("C:/Users/hp/OneDrive/Desktop/gait-in-neurodegenerative-disease-database-1.0.0")

    strides = load_all_ts(DATA_DIR)
    print(f"Loaded {len(strides)} strides from {strides['subject_id'].nunique()} subjects")
    print(strides['label'].value_counts())
    print(strides.head())

    strides.to_csv("gaitndd_strides.csv", index=False)
    print("\nSaved combined dataset to gaitndd_strides.csv")